{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "DISABLE_FEEDBACK_COMMAND": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.githooks/claude-content-guard.sh\"",
            "statusMessage": "Checking content denylist"
          }
        ]
      }
    ]
  }
}
