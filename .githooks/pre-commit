#!/usr/bin/env bash
# Block commits whose staged CONTENT contains a denylisted word.
# See .githooks/denylist.txt for the list and the rationale.
set -euo pipefail

source "$(dirname "$0")/_scan.sh"
pattern="$(build_pattern)"
[ -z "$pattern" ] && exit 0

fail=0
while IFS= read -r file; do
  [ -z "$file" ] && continue
  # The hook dir holds the denylist itself — never scan it.
  case "$file" in .githooks/*) continue ;; esac

  # Only the lines this commit ADDS, content only (drop the +++ diff header).
  hits=$(git diff --cached --no-color -U0 -- "$file" \
           | grep -E '^\+' | grep -vE '^\+\+\+' \
           | grep -iE "$pattern" || true)

  if [ -n "$hits" ]; then
    echo "  ✗ $file"
    echo "$hits" | sed 's/^+/      /'
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACM)

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit blocked: staged content matches the denylist (.githooks/denylist.txt)."
  echo "Remove the flagged text, or edit the denylist if this is a false positive."
  exit 1
fi
